# Whitelist mode: keep the repo to the shipped plugins + their distribution/dev scaffolding.
# Nothing runtime, local, or personal should ever land here.
/*

# --- Marketplace manifest (root) ---
!/.claude-plugin/

# --- Shipped plugins (harness kit + devlog companion) ---
!/plugins/

# --- Distribution / maintenance tooling ---
!/README.md
!/LICENSE
!/CHANGELOG.md
!/.gitignore
!/.gitattributes

# --- Regression evals for the kit (dev harness, not shipped) ---
!/evals/

# --- Dev harness for developing THIS repo (curated only) ---
!/.claude/
/.claude/*
!/.claude/CLAUDE.md
!/.claude/DEMO.md
!/.claude/devlog/
!/.claude/skills/
!/.claude/audits/
/.claude/audits/**
!/.claude/audits/*/
!/.claude/audits/*/AUDIT-*.json

# Never track even inside whitelisted dirs
.credentials.json
settings.local.json
*.bak*
*.log
__pycache__/
.pytest_cache/
.DS_Store

# eval-прогоны: сырые выводы кладутся вручную; git-каталоги фикстур — никогда
evals/results/*.tmp
evals/fixtures/**/.git/
